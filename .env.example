# ==================================================
# PréQuali — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ==================================================

# --- Base de données PostgreSQL ---
DATABASE_URL="postgresql://user:password@localhost:5432/prequali"

# --- NextAuth (session admin) ---
NEXTAUTH_SECRET="générer avec: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Compte admin initial (utilisé par prisma/seed.ts) ---
ADMIN_EMAIL="admin@votreentreprise.com"
# Générer avec: node -e "console.log(require('bcryptjs').hashSync('votreMotDePasse', 10))"
ADMIN_PASSWORD_HASH=""

# --- Email transactionnel (OTP courriel) — Resend ---
RESEND_API_KEY=""
EMAIL_FROM="PréQuali <verification@votredomaine.com>"

# --- SMS (OTP téléphone) — Twilio ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- Rate limiting / anti-abus — Upstash Redis ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Paramètres OTP ---
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Versions des documents légaux (utilisées pour la journalisation du consentement) ---
POLITIQUE_CONFIDENTIALITE_VERSION="1.0"
CONDITIONS_UTILISATION_VERSION="1.0"

# --- Journalisation du consentement ---
# "true" pour enregistrer l'adresse IP avec la preuve de consentement.
# Laisser "false" tant que le besoin n'est pas établi (minimisation des données).
STORE_CONSENT_IP="false"
